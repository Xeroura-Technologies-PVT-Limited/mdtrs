# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://medtoursin.com

# Care portal. Set both values from the same project's Connect dialog.
# Use .env.local for local development and .env.production.local for production builds.
# For hosted deployments, set both variables in the host's Production environment.
# The key is included in the browser bundle. Use the publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings for npm run db:migrate. Set these on the migration runner.
# Direct connection: use the hosted project URL above plus its database password.
# SUPABASE_DB_PASSWORD="your-database-password"
# Alternatively, copy the Session pooler URI from Supabase > Connect (port 5432).
# Percent-encode special characters in a password embedded in a URI.
# SUPABASE_DB_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres"

# Enquiry delivery (not wired yet, see src/app/api/enquiry/route.ts).
# ENQUIRY_TO=drravitejabuddha@gmail.com
# RESEND_API_KEY=
